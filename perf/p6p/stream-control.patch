+
+static __global__ void ik_stream_only(const uint4 * w, int vectors, const int * ids, float * out, int nout, bool read) {
+    const int slice = blockIdx.y;
+    const int tid = blockIdx.x*blockDim.x + threadIdx.x;
+    if (read) {
+        const uint4 * base = w + (ids ? (int64_t) ids[slice]*vectors : 0);
+        for (int i = tid; i < vectors; i += blockDim.x*gridDim.x) {
+            uint4 v;
+            asm volatile("ld.volatile.global.v4.u32 {%0,%1,%2,%3}, [%4];" : "=r"(v.x), "=r"(v.y), "=r"(v.z), "=r"(v.w) : "l"(base + i));
+        }
+    }
+    for (int i = tid; i < nout; i += blockDim.x*gridDim.x) { out[slice*nout+i] = 0.0f; }
+}
+
+bool ggml_cuda_inkling_stream_control(ggml_backend_cuda_context & ctx, ggml_tensor * dst, bool segmented) {
+    static const int mode = getenv("IK_DIAG_STREAM") ? atoi(getenv("IK_DIAG_STREAM")) : 0;
+    if (!mode) { return false; }
+    const ggml_tensor * w = dst->src[0];
+    const bool expert = dst->op == GGML_OP_MUL_MAT_ID;
+    if ((w->type != GGML_TYPE_IQ4_NL && w->type != GGML_TYPE_Q2_0 && w->type != GGML_TYPE_Q2_K) ||
+            (expert ? (!ggml_is_vector(dst->src[2]) || dst->ne[1] != 8 || !ggml_is_matrix(dst)) :
+            ((!segmented && dst->ne[1] != 1) || !ggml_is_matrix(dst))) ||
+            !ggml_is_contiguous(dst) || !ggml_is_contiguous(w) || w->nb[2] % 16 || dst->type != GGML_TYPE_F32) { return false; }
+    const int nvec = w->nb[2]/16;
+    const int slots = expert ? 8 : 1;
+    const int blocks = std::min(8*82/slots, (nvec+255)/256);
+    ik_stream_only<<<dim3(blocks,slots),256,0,ctx.stream()>>>((const uint4 *) w->data, nvec, expert ? (const int *) dst->src[2]->data : nullptr,
+            (float *) dst->data, ggml_nelements(dst)/slots, mode == 1);
+    return true;
+}
