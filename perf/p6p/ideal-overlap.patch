+static __global__ void ik_ideal_init(uint4 * buf, int n) {
+    for (int i = blockIdx.x*blockDim.x + threadIdx.x; i < n; i += blockDim.x*gridDim.x) {
+        uint32_t x = (i+1u)*2654435761u;
+        buf[i] = make_uint4(x,x*31u,x ^ (x>>13),x*69069u);
+    }
+}
+static __global__ void ik_ideal_read(const uint4 * buf, int n) {
+    const int stride = blockDim.x*gridDim.x;
+    for (int i = blockIdx.x*blockDim.x + threadIdx.x; i < n; i += 8*stride) {
+#pragma unroll
+        for (int j=0;j<8;++j) {
+            const int idx=i+j*stride;
+            if (idx<n) {
+                uint4 v;
+                asm volatile("ld.volatile.global.v4.u32 {%0,%1,%2,%3}, [%4];" : "=r"(v.x),"=r"(v.y),"=r"(v.z),"=r"(v.w):"l"(buf+idx));
+            }
+        }
+    }
+}
+void ik_control_stream(cudaStream_t stream, bool start) {
+    static int blocks = getenv("IK_IDEAL_BLOCKS") ? atoi(getenv("IK_IDEAL_BLOCKS")) : 0;
+    if (!blocks) { return; }
+    static uint4 * buf;
+    static cudaStream_t other;
+    static cudaEvent_t ready, done;
+    static int count;
+    constexpr int vectors = 2006510000/16;
+    if (!buf) {
+        CUDA_CHECK(cudaMalloc(&buf,size_t(vectors)*16));
+        CUDA_CHECK(cudaStreamCreateWithFlags(&other,cudaStreamNonBlocking));
+        CUDA_CHECK(cudaEventCreateWithFlags(&ready,cudaEventDisableTiming));
+        CUDA_CHECK(cudaEventCreateWithFlags(&done,cudaEventDisableTiming));
+        ik_ideal_init<<<1024,256,0,other>>>(buf,vectors);
+        CUDA_CHECK(cudaStreamSynchronize(other));
+        atexit([]{fprintf(stderr,"optimistic stream: %d graph launches, 2006510000 bytes each\n",count);});
+    }
+    if (!start) {
+        if (blocks>0) { CUDA_CHECK(cudaStreamWaitEvent(stream,done)); }
+        return;
+    }
+    ++count;
+    CUDA_CHECK(cudaEventRecord(ready,stream));
+    CUDA_CHECK(cudaStreamWaitEvent(other,ready));
+    if (blocks>0) {
+        ik_ideal_read<<<blocks,256,0,other>>>(buf,vectors);
+        CUDA_CHECK(cudaEventRecord(done,other));
+    } else {
+        ik_ideal_read<<<-blocks,256,0,stream>>>(buf,vectors);
+    }
+}
